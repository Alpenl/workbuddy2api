# Auth & secrets
auths/
data/
*.key
*.pem

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin

# Config with secrets (use config.example.json)
config.json

# Build artifacts
*.tmp
__pycache__/
frontend/node_modules/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/src/**/*.js
frontend/src/**/*.vue.js
frontend/vite.config.js
frontend/vite.config.d.ts
internal/web/dist/*
!internal/web/dist/.gitkeep

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
docs/

# 设计/计划文档（但 README.md 必须进版本库）
*.md
!README.md
!docker-build/deploy.md
